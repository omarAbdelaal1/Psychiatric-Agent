{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/frontend/$1"
    },
    {
      "src": "/(css|js)/(.*)",
      "dest": "/frontend/$1/$2"
    },
    {
      "src": "/(health|api/health)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(api/live-config|live-config)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(api/protocols|protocols)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(api/crisis|crisis)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(api/info|info)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(api/patient/.*|patient/.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(api/session/.*|session/.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/$",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
